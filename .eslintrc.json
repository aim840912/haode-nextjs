{
  "extends": ["next/core-web-vitals"],
  "env": {
    "browser": true,
    "es2022": true,
    "worker": true,
    "serviceworker": true
  },
  "globals": {
    "JSX": "readonly"
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "prefer-const": "error",
    "no-var": "error"
  },
  "overrides": [
    {
      "files": ["src/lib/workers/**/*.ts"],
      "env": {
        "worker": true
      },
      "rules": {
        "no-restricted-globals": "off"
      }
    }
  ]
}
