{
  "name": "haude",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev --turbopack",
    "build": "npx next build",
    "analyze": "ANALYZE=true npm run build",
    "start": "npx next start",
    "lint": "npx eslint src/",
    "lint:all": "npx eslint .",
    "type-check": "tsc --noEmit",
    "lint-fix": "npx eslint --fix src/",
    "pre-commit": "npm run type-check && npm run lint-fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ci": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:supabase": "npx tsx scripts/test-supabase.ts",
    "test:supabase-quick": "npx tsx scripts/quick-test.ts",
    "check:tables": "npx tsx scripts/check-tables.ts",
    "migrate:products": "npx tsx scripts/migrate-to-supabase.ts",
    "generate:keys": "node scripts/generate-keys.js",
    "generate:keys:simple": "node scripts/generate-keys.js --simple",
    "db:optimize": "npx tsx scripts/deploy-database-optimization.ts",
    "db:optimize:index": "npx tsx scripts/apply-index-optimization.ts",
    "db:optimize:search": "npx tsx scripts/apply-full-text-search.ts",
    "db:monitor": "npx tsx scripts/cache-performance-monitor.ts",
    "db:analyze": "npx tsx scripts/database-performance-analyzer.ts",
    "mcp:test": "SUPABASE_ACCESS_TOKEN=sbp_5e3868ec81de0cbf77f283a5c52a79d28bb7d2de npx @supabase/mcp-server-supabase --read-only --project-ref=bxlrtcagsuoijjolgdzs --features=database,docs",
    "mcp:help": "echo 'Supabase MCP Server 使用方法：' && echo 'npm run mcp:test - 測試連接' && echo 'npm run mcp:version - 顯示版本'",
    "mcp:version": "npx @supabase/mcp-server-supabase --version",
    "mcp:setup": "echo '請設定 SUPABASE_ACCESS_TOKEN 環境變數後運行 npm run mcp:test'",
    "mcp:test-connection": "node scripts/test-mcp-connection.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
